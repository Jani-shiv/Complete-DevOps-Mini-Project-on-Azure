# =============================================================================
# Docker Ignore File
# =============================================================================
# Exclude unnecessary files from Docker build context

# Git
.git
.gitignore
.github

# Documentation
docs/
*.md
!README.md

# Development files
.env
.env.*
*.pyc
__pycache__
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
tests/

# Build artifacts
*.egg-info/
dist/
build/
*.egg

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker
docker-compose*.yml
Dockerfile*
!Dockerfile
.dockerignore
